{
  "rules": {
    ".read": false,
    ".write": false,

    "bids": {
      "auction": {
        "$auctionId": {
          ".read": true,
          ".write": false
        }
      }
    },

    "activity": {
      "auction": {
        "$auctionId": {
          ".read": true,
          ".write": false
        }
      },
      "global": {
        ".read": true,
        ".write": false
      }
    },

    "notifications": {
      "user": {
        "$userId": {
          ".read": "auth !== null && auth.uid === $userId",
          ".write": false
        }
      }
    },

    "chat": {
      "conversation": {
        "$conversationId": {
          ".read": "auth !== null && (auth.token.isAdmin === true || root.child('chat/conversation/' + $conversationId + '/meta/participants/' + auth.uid).val() === true)",
          ".write": false,
          "meta": {
            ".read": "auth !== null && (auth.token.isAdmin === true || root.child('chat/conversation/' + $conversationId + '/meta/participants/' + auth.uid).val() === true)",
            ".write": false
          }
        }
      }
    },

    "status": {
      "auction": {
        "$auctionId": {
          ".read": true,
          ".write": false
        }
      }
    },

    "presence": {
      "auction": {
        "$auctionId": {
          ".read": true,
          "$userId": {
            ".write": "auth !== null && auth.uid === $userId"
          }
        }
      }
    }
  }
}
