rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Auction images — publicly readable. WRITES ARE SERVER-ONLY: all uploads
    // go through POST /api/upload, which validates magic bytes + runs Cloud
    // Vision SafeSearch before saving via the Admin SDK (which bypasses these
    // rules). A client-supplied contentType is trivially spoofable, so allowing
    // direct client writes would let users bypass moderation entirely.
    match /auctions/{userId}/{allPaths=**} {
      allow read:  if true;
      allow write: if false;
    }

    // Profile avatars + banners — publicly readable (they render on public
    // profile pages). Server-only writes, same moderation pipeline as auctions.
    match /profiles/{userId}/{allPaths=**} {
      allow read:  if true;
      allow write: if false;
    }

    // Chat attachments — only the uploader can read directly; other
    // conversation participants receive a short-lived signed URL minted by
    // /api/upload (which performs an app-level conversation-membership check).
    // Writes are server-only for the same moderation-bypass reason as above.
    match /chat/{userId}/{allPaths=**} {
      allow read:  if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Block everything else
    match /{allOtherPaths=**} {
      allow read, write: if false;
    }
  }
}
