rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Auction images — publicly readable, only owner can write
    match /auctions/{userId}/{allPaths=**} {
      allow read:  if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size  < 4 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Chat attachments — authenticated users can read, only sender can write
    match /chat/{userId}/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size  < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Block everything else
    match /{allOtherPaths=**} {
      allow read, write: if false;
    }
  }
}
