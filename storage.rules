rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Auction images — publicly readable, only owner can write
    match /auctions/{userId}/{allPaths=**} {
      allow read:  if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size  < 4 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Chat attachments — only the uploader can read directly. Other
    // conversation participants receive a short-lived signed URL minted by
    // /api/upload (which performs an app-level conversation-membership check).
    // Without this restriction any authenticated user could enumerate every
    // chat upload across the whole platform.
    match /chat/{userId}/{allPaths=**} {
      allow read:  if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size  < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Block everything else
    match /{allOtherPaths=**} {
      allow read, write: if false;
    }
  }
}
