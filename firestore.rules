rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ─── AUTH HELPERS ───
    //
    // request.auth is populated when the client signs in via Firebase Auth
    // with a custom token minted at GET /api/firebase/token. That endpoint
    // embeds `isAdmin` as a custom claim when the NextAuth session indicates
    // admin (see src/app/api/firebase/token/route.ts).
    //
    // Trust model: the isAdmin claim can lag behind a server-side admin
    // revocation by up to one Firebase token TTL (~1h). All write paths and
    // sensitive read paths route through Server Actions that DB-verify via
    // requireAdmin(); these client-side rules govern only direct reads of
    // public/user-owned docs, where a brief staleness window is acceptable.
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.isAdmin == true;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // ─── COLLECTION RULES ───
    
    // NOTE: All WRITES are handled via Server Actions (Firebase Admin SDK).
    // Client-side writes are strictly forbidden to ensure logic, sanitization, 
    // and rate-limiting integrity.

    match /users/{userId} {
      // Users can read their own profile; admins can read all.
      allow read: if isSelf(userId) || isAdmin();
      // Only Server Actions can create/update users.
      allow write: if false;
    }

    match /auctions/{auctionId} {
      // Publicly readable.
      allow read: if true;
      // Mutations only via Server Actions.
      allow write: if false;
    }

    match /bids/{bidId} {
      // Publicly readable (limited).
      allow read: if true;
      // Mutations only via Server Actions to prevent shill bidding and ensure transactions.
      allow write: if false;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if false;
    }

    match /reports/{reportId} {
      allow read: if isAdmin();
      // Reports can only be submitted via Server Actions to ensure sanitization.
      allow write: if false;
    }

    // Seller follows — composite ID `{followerId}_{sellerId}`. Each user can
    // see their own follows; sellers can see who follows them. Writes only
    // via Server Actions (followSeller / unfollowSeller).
    match /sellerFollows/{docId} {
      allow read: if signedIn() && (
        isAdmin() ||
        resource.data.followerId == request.auth.uid ||
        resource.data.sellerId   == request.auth.uid
      );
      allow write: if false;
    }

    // Auction Q&A — public discovery feature. Anyone can read; writes only
    // via Server Actions to enforce PII filter, rate limiting, and seller-only
    // answer authorization.
    match /auctionQuestions/{questionId} {
      allow read: if true;
      allow write: if false;
    }

    match /conversations/{conversationId} {
      allow read: if signedIn() && (
        isAdmin() || 
        resource.data.buyerId == request.auth.uid || 
        resource.data.sellerId == request.auth.uid
      );
      allow write: if false;
    }

    match /messages/{messageId} {
      // buyerId and sellerId are denormalized onto each message doc (see chat.ts sendMessage).
      // This avoids a per-read get() on the conversations collection, halving read costs
      // for chat history loads.
      allow read: if signedIn() && (
        isAdmin() ||
        resource.data.buyerId  == request.auth.uid ||
        resource.data.sellerId == request.auth.uid
      );
      allow write: if false;
    }

    match /systemConfig/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Admin audit log — admins can read; only Server Actions write.
    match /admin_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Cron failure log — admins can read; only Server Actions / cron handlers write.
    match /cronFailures/{failureId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Financial ledger — immutable money-movement trail. Admins read; only
    // Server Actions (Admin SDK) write. Never client-writable.
    match /ledgerEntries/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ─── CATCH-ALL ───
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
