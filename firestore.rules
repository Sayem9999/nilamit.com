rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ─── AUTH HELPERS ───
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.isAdmin == true;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // ─── COLLECTION RULES ───
    
    // NOTE: All WRITES are handled via Server Actions (Firebase Admin SDK).
    // Client-side writes are strictly forbidden to ensure logic, sanitization, 
    // and rate-limiting integrity.

    match /users/{userId} {
      // Users can read their own profile; admins can read all.
      allow read: if isSelf(userId) || isAdmin();
      // Only Server Actions can create/update users.
      allow write: if false;
    }

    match /auctions/{auctionId} {
      // Publicly readable.
      allow read: if true;
      // Mutations only via Server Actions.
      allow write: if false;
    }

    match /bids/{bidId} {
      // Publicly readable (limited).
      allow read: if true;
      // Mutations only via Server Actions to prevent shill bidding and ensure transactions.
      allow write: if false;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if false;
    }

    match /reports/{reportId} {
      allow read: if isAdmin();
      // Reports can only be submitted via Server Actions to ensure sanitization.
      allow write: if false;
    }

    match /conversations/{conversationId} {
      allow read: if signedIn() && (
        isAdmin() || 
        resource.data.buyerId == request.auth.uid || 
        resource.data.sellerId == request.auth.uid
      );
      allow write: if false;
    }

    match /messages/{messageId} {
      // buyerId and sellerId are denormalized onto each message doc (see chat.ts sendMessage).
      // This avoids a per-read get() on the conversations collection, halving read costs
      // for chat history loads.
      allow read: if signedIn() && (
        isAdmin() ||
        resource.data.buyerId  == request.auth.uid ||
        resource.data.sellerId == request.auth.uid
      );
      allow write: if false;
    }

    match /systemConfig/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Admin audit log — admins can read; only Server Actions write.
    match /admin_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Cron failure log — admins can read; only Server Actions / cron handlers write.
    match /cronFailures/{failureId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ─── CATCH-ALL ───
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
