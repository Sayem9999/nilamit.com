{
  "apphosting": {},
  "database": {
    "rules": "database.rules.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions",
    "codebase": "default",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firestore-debug.log"
    ]
  },
  "extensions": {
    "firestore-send-email": "firebase/firestore-send-email@0.2.8",
    "storage-resize-images": "firebase/storage-resize-images@0.3.3"
  }
}
