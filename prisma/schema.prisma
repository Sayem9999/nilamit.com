// Prisma Schema for nilamit.com — C2C Auction Marketplace (Bangladesh)
// Database: PostgreSQL via Supabase

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── User ─────────────────────────────────────────────
model User {
  id              String   @id @default(cuid())
  name            String?
  email           String   @unique
  emailVerified   DateTime?
  image           String?
  password        String?  // Hashed password (Phase 1.5)
  phone           String?  @unique
  isPhoneVerified Boolean  @default(false)
  isVerifiedSeller Boolean @default(false)
  reputationScore Int      @default(0)
  googleId        String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  accounts          Account[]
  sessions          Session[]
  auctionsAsSeller  Auction[]  @relation("Seller")
  auctionsAsWinner  Auction[]  @relation("Winner")
  bids              Bid[]
  phoneVerifications PhoneVerification[]
  bidDeposits       BidDeposit[]
  
  // Reputation (Phase 3)
  reviewsGiven      Review[]   @relation("ReviewsFrom")
  reviewsReceived   Review[]   @relation("ReviewsTo")

  // Phase 9
  watchlist         Watchlist[]
  reportsSubmitted  AuctionReport[]
  
  // Elevation 7
  preferences       UserPreference?
  alerts            Alert[]
  bulkOperations    BulkOperation[]
  
  // Elevation 8: Social Proof
  winningStreak     Int      @default(0)
  userLevel         Int      @default(1)
  circlesOwned      AuctionCircle[] @relation("CircleOwner")
  circleMemberships CircleMember[]
  badges            UserBadge[]

  // Sandbox Escrow (Phase 10)
  escrowTransactions EscrowTransaction[]
  disputesOpened     Dispute[] @relation("DisputeOpener")

  @@index([email])
  @@index([phone])
}

// ─── Auth.js Required Models ──────────────────────────
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Auction ──────────────────────────────────────────
model Auction {
  id              String        @id @default(cuid())
  title           String
  description     String        @db.Text
  images          String[]      // Array of image URLs
  category        String
  location        String?       // mirpur, banani, dhanmondi, etc.
  startingPrice   Float
  currentPrice    Float
  reservePrice    Float?        // Optional minimum hidden price for item to sell
  buyItNowPrice   Float?        // Optional instant purchase price
  minBidIncrement Float         @default(10)
  startTime       DateTime
  endTime         DateTime
  status          AuctionStatus @default(DRAFT)
  isFeatured      Boolean       @default(false)
  commissionRate  Float         @default(0.05) // 5% default commission
  commissionEarned Float?       // Calculated on SOLD
  
  deliveryStatus  OrderStatus?   @default(PENDING) // Assigned on SOLD
  trackingNumber  String?
  
  sellerId        String
  seller          User          @relation("Seller", fields: [sellerId], references: [id])
  winnerId        String?
  winner          User?         @relation("Winner", fields: [winnerId], references: [id])
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  bids            Bid[]
  bidDeposits     BidDeposit[]
  reviews         Review[]

  // Phase 9
  watchlist       Watchlist[]
  reports         AuctionReport[]
  
  // Elevation 7
  alerts          Alert[]

  // Elevation 8: Social
  circleId        String?
  circle          AuctionCircle? @relation(fields: [circleId], references: [id])
  
  // Sandbox Escrow (Phase 10)
  escrowTransaction EscrowTransaction?

  @@index([status, endTime])
  @@index([category])
  @@index([location])
  @@index([sellerId])
}

enum OrderStatus {
  PENDING
  SHIPPED
  DELIVERED
  RECEIVED
}

enum AuctionStatus {
  DRAFT
  ACTIVE
  SOLD
  EXPIRED
  CANCELLED
  AWAITING_PAYMENT // Added for Escrow Sandbox
}

// ─── Bid ──────────────────────────────────────────────
model Bid {
  id        String   @id @default(cuid())
  amount    Float
  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id])
  bidderId  String
  bidder    User     @relation(fields: [bidderId], references: [id])
  createdAt DateTime @default(now())

  @@index([auctionId, createdAt(sort: Desc)])
  @@index([bidderId])
}

// ─── Phone Verification (OTP) ─────────────────────────
model PhoneVerification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String
  otp       String   // Hashed OTP
  expiresAt DateTime
  verified  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId, phone])
}

// ─── Bid Deposit (Trust Mechanism) ────────────────────
model BidDeposit {
  id        String        @id @default(cuid())
  amount    Float
  status    DepositStatus @default(held)
  bidderId  String
  bidder    User          @relation(fields: [bidderId], references: [id])
  auctionId String
  auction   Auction       @relation(fields: [auctionId], references: [id])
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([bidderId, auctionId])
}

enum DepositStatus {
  held
  released
  forfeited
}

// ─── Review (Trust System) ────────────────────────────
model Review {
  id        String   @id @default(cuid())
  rating    Int      @default(5) // 1 to 5
  comment   String?  @db.Text
  
  fromId    String
  from      User     @relation("ReviewsFrom", fields: [fromId], references: [id])
  toId      String
  to        User     @relation("ReviewsTo", fields: [toId], references: [id])
  
  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id])
  
  createdAt DateTime @default(now())

  @@unique([fromId, auctionId]) // One review per auction per user
  @@index([toId])
}

// ─── Watchlist (Phase 9) ─────────────────────────────
model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, auctionId])
  @@index([userId])
  @@index([auctionId])
}

// ─── Auction Report (Phase 9) ───────────────────────
model AuctionReport {
  id          String       @id @default(cuid())
  reason      String
  description String?      @db.Text
  status      ReportStatus @default(PENDING)
  
  auctionId   String
  auction     Auction      @relation(fields: [auctionId], references: [id])
  reporterId  String
  reporter    User         @relation(fields: [reporterId], references: [id])
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([auctionId])
  @@index([reporterId])
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

// ─── Behavioral Tracking (Elevation 7) ──────────────
model UserPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  viewedCategories String[] // Most viewed categories
  searchHistory    String[] 
  affinityScore   Json?    // Category -> score mapping for AI
  
  updatedAt       DateTime @updatedAt
}

// ─── Smart Alerts (Elevation 7) ──────────────────────
model Alert {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  auctionId       String?
  auction         Auction?    @relation(fields: [auctionId], references: [id])
  
  type            AlertType
  thresholdPrice  Float?
  isActive        Boolean     @default(true)
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId])
}

enum AlertType {
  PRICE_DROP
  ENDING_SOON
  OUTBID
  NEW_AUCTION_IN_CATEGORY
}

// ─── Bulk Operations (Elevation 7) ──────────────────
model BulkOperation {
  id              String   @id @default(cuid())
  sellerId        String
  seller          User     @relation(fields: [sellerId], references: [id])
  
  status          String   // PENDING, PROCESSING, COMPLETED, FAILED
  fileName        String
  totalRows       Int
  processedRows   Int      @default(0)
  errors          Json?    // Row -> Error message mapping
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── System Config (Phase 11) ───────────────────────
model SystemConfig {
  id             String   @id @default("default")
  
  // Hero Section
  heroTitle      String   @default("Buy & Sell in Real-time Auctions")
  heroSubtitle   String   @default("Bangladesh's most trusted C2C marketplace.")
  heroImage      String?
  
  // Announcement Bar
  announcement   String?
  showAnnouncement Boolean @default(false)
  
  updatedAt      DateTime @updatedAt
}

// ─── Auction Circles (Elevation 8) ──────────────────
model AuctionCircle {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  inviteCode  String   @unique
  
  ownerId     String
  owner       User     @relation("CircleOwner", fields: [ownerId], references: [id])
  
  members     CircleMember[]
  auctions    Auction[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CircleMember {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  circleId    String
  circle      AuctionCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  
  joinedAt    DateTime @default(now())

  @@unique([userId, circleId])
  @@index([userId])
  @@index([circleId])
}

// ─── Gamification (Phase 10) ────────────────────────
model UserBadge {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  badgeId     String   // e.g., "early_bird", "sniper", "whale"
  earnedAt    DateTime @default(now())
  
  @@unique([userId, badgeId]) // A user gets a specific badge type only once
  @@index([userId])
}

// ─── Escrow Sandbox (Phase 10) ──────────────────────
model EscrowTransaction {
  id              String   @id @default(cuid())
  
  auctionId       String   @unique
  auction         Auction  @relation(fields: [auctionId], references: [id])
  
  buyerId         String
  buyer           User     @relation(fields: [buyerId], references: [id])
  
  amount          Float
  status          EscrowStatus @default(PENDING) // PENDING -> HELD -> RELEASED/REFUNDED
  
  paymentMethod   String?  // simulated identifier
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  dispute         Dispute?

  @@index([buyerId])
}

model Dispute {
  id              String   @id @default(cuid())
  transactionId   String   @unique
  transaction     EscrowTransaction @relation(fields: [transactionId], references: [id])
  openerId        String
  opener          User     @relation("DisputeOpener", fields: [openerId], references: [id])
  reason          String   @db.Text
  status          DisputeStatus @default(OPEN)
  resolution      String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum DisputeStatus {
  OPEN
  RESOLVED_SELLER // Escrow released
  RESOLVED_BUYER  // Escrow refunded
}

enum EscrowStatus {
  PENDING
  HELD
  RELEASED
  REFUNDED
  DISPUTED
}

