# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.claude/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# firebase / cloud run
.firebase/
.firebaserc.local
firebase-debug.log*
firebaseapphosting-debug.log*

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# lint logs
lint*.txt
lint.json
lint.log
final-lint.txt

playwright-report/
test-results/
/scratch/

# android / TWA build — never commit the signing keystore or raw build outputs.
# (The published APK lives at public/downloads/nilamit.apk and is NOT ignored.)
*.keystore
android.keystore
android-keystore-credentials.txt
keystore.b64
/app-release-signed.apk
/app-release-unsigned.apk
/app-release-bundle.aab
/app/
/store_icon.png


# e2e seeded creds (generated by global-setup)
tests/e2e/.seed.json

# native app — separate Expo project (own git repo under /mobile). Built &
# published via EAS; the resulting APK is committed at public/downloads/nilamit.apk
# (NOT ignored). The source tree itself stays out of the web repo/deploy.
/mobile/
